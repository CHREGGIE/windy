{
  "expo": {
    "name": "WindCheck",
    "slug": "windcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2050FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WindCheck uses your location only to fetch the forecast where you are. It is never sold or shared."
        }
      ]
    ],
    "scheme": "windcheck",
    "splash": {
      "backgroundColor": "#F4F3EF"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
